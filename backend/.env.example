# Supabase credentials
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-supabase-anon-key

# ESP32-CAM stream URL
CAMERA_URL=http://YOUR_ESP32_CAM_IP:81/stream

# YOLO model paths
NORMAL_MODEL_PATH=yolo11n.pt
NIGHT_MODEL_PATH=path/to/your/night-model/best.pt

# Video path for testing
NIGHT_VIDEO_PATH=path/to/your/night-vision-video.mp4

# ESP32 command URL
ESP32_COMMAND_URL=http://YOUR_ESP32_IP
